+func TestPlayerokRecoversAfterProlongedOutageWithoutOverridingStop(t *testing.T) {
+	b, n := playerokFixture(t)
+	p := newPlayerokService(b)
+	p.wanted = true
+	p.state = "DEGRADED"
+	available := false
+	connects := 0
+	p.catalog = func() ([]discoveredNode, error) { return []discoveredNode{n}, nil }
+	p.listener = func() (uint32, error) { return 0, nil }
+	p.action = func(ctx context.Context, cmd string, ids ...string) response {
+		if cmd == "connect" {
+			connects++
+			return response{"ok": available}
+		}
+		return response{"ok": true}
+	}
+	for i := 0; i < 8; i++ {
+		p.next = time.Time{}
+		p.watchdog(context.Background(), false)
+		if p.state == "READY" {
+			t.Fatal("unavailable route reported ready")
+		}
+		delay := time.Until(p.next)
+		if delay <= 0 || delay > 5*time.Minute {
+			t.Fatal("recovery must have bounded backoff")
+		}
+		before := connects
+		p.watchdog(context.Background(), false)
+		if connects != before {
+			t.Fatal("retried before deadline")
+		}
+	}
+	available = true
+	generation := p.generation
+	p.next = time.Time{}
+	p.watchdog(context.Background(), false)
+	if p.state != "READY" || p.generation != generation+1 {
+		t.Fatal("route did not recover after prolonged outage")
+	}
+	p.command(context.Background(), "stop", "")
+	before := connects
+	p.next = time.Time{}
+	p.watchdog(context.Background(), false)
+	if p.state != "STOPPED" || connects != before {
+		t.Fatal("STOP overridden")
+	}
+}
