+func TestPlayerokAllFiveEligibleCandidatesAreAttempted(t *testing.T) {
+	b, base := playerokFixture(t)
+	p := newPlayerokService(b)
+	nodes := []discoveredNode{}
+	for i := 0; i < 5; i++ {
+		n := base
+		n.ID = fmt.Sprintf("fixture-%d", i)
+		nodes = append(nodes, n)
+	}
+	p.catalog = func() ([]discoveredNode, error) { return append([]discoveredNode(nil), nodes...), nil }
+	p.listener = func() (uint32, error) { return 0, nil }
+	tried := []string{}
+	p.action = func(ctx context.Context, cmd string, ids ...string) response {
+		if cmd == "connect" {
+			tried = append(tried, ids[0])
+			return response{"ok": false}
+		}
+		return response{"ok": true}
+	}
+	p.connect(context.Background(), "")
+	if len(tried) != 5 || p.state != "DEGRADED" {
+		t.Fatalf("all five candidates must be checked without claiming success: %d, %s", len(tried), p.state)
+	}
+	tried = nil
+	p.action = func(ctx context.Context, cmd string, ids ...string) response {
+		if cmd == "connect" {
+			tried = append(tried, ids[0])
+			return response{"ok": ids[0] == nodes[4].ID}
+		}
+		return response{"ok": true}
+	}
+	p.connect(context.Background(), "")
+	if len(tried) != 5 || p.state != "READY" || p.b.serverID != nodes[4].ID {
+		t.Fatal("fifth verified candidate did not restore service")
+	}
+}
