TELEGRAM_BOT_TOKEN=
PLAYEROK_HEADER_STRING=
TELEGRAM_API_PROXY_URL=
# Set explicitly. No first-user registration.
OWNER_IDS=
# User explicitly requested first /start ownership. Keep false unless desired.
FIRST_START_CLAIM=false
TELEGRAM_USE_PROXY=false
# Default: independent localVPN Playerok service. Worker is an explicit legacy option.
TELEGRAM_TRANSPORT=localvpn
# Optional absolute override if the existing resource tree is relocated:
# LOCALVPN_PLAYEROK_EXE=C:/Users/user/Documents/Codex/2026-10-19/pa/outputs/playerok-proxy/localvpn-playerok.exe
PLAYEROK_WRITES_ENABLED=false
# Separate seller-terms-only permission; never enables other writes or payments.
PLAYEROK_AUTO_ACCEPT_AGREEMENTS=false
PLAYEROK_AUTOMATION_ENABLED=false
PLAYEROK_REALTIME_ENABLED=true
# Deprecated compatibility setting; ignored for both true and false. Use specific flags below.
PAID_OPERATIONS_ENABLED=false

# Personal MTProto Gifts. Authorize locally: python -m app.gifts.auth
# Keep payments OFF until a separately authorized controlled live acceptance.
TG_USER_API_ID=
TG_USER_API_HASH=
TG_USER_SESSION_PATH=data/telegram_personal.session
PLAYEROK_STARS_CATEGORY_ID=1ef2da4b-1ffc-62f0-b165-b07be0dc1444
PLAYEROK_STARS_GIFT_OBTAINING_ID=1effb589-89db-61a0-5e74-3e27df00c994
# Exact OBTAINING_DATA field, rechecked read-only 2026-10-30. Playerok required=false;
# the application ALWAYS requires its value and never falls back to comments.
PLAYEROK_STARS_USERNAME_FIELD_ID=1effb589-d13f-6780-15ec-fe00995e7539
TG_GIFT_PAYMENTS_ENABLED=false
TG_GIFT_REFUNDS_ENABLED=false
TG_GIFT_MAX_ORDER_STARS=100
TG_GIFT_MAX_DAILY_STARS=300
TG_GIFT_MAX_COUNT=5
DATABASE_PATH=data/control_center.sqlite3
LOG_LEVEL=INFO
